<UserControl x:Class="NIM.YDControls.NodeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:NIM.YDControls"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="360"
             Background="Transparent">

    <UserControl.Resources>

        <!-- ===== Scrollbar (thin, dark) ===== -->
        <Style x:Key="NullRepeat" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThinThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="T" Margin="1,0" CornerRadius="3" Background="#55FFFFFF"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="T" Property="Background" Value="#99FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="T" Property="Background" Value="#CCFFE600"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Width="8" Background="#11FFFFFF">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource NullRepeat}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource NullRepeat}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ThinThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Switch ===== -->
        <Style x:Key="SwitchStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <Border x:Name="Track" CornerRadius="9" Background="#FF1B1B1B"
                                    BorderBrush="#FF484848" BorderThickness="1"/>
                            <Ellipse x:Name="Thumb" Width="12" Height="12" Fill="#FF8A8A8A"
                                     HorizontalAlignment="Left" Margin="3,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#33FFFFFF"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="#CCFFFFFF"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="#FFFFFFFF"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="#FFFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Node row ===== -->
        <DataTemplate x:Key="NodeTemplate">
            <Border x:Name="Row" Height="40" Background="#FF111111"
                    BorderBrush="#FF1C1C1C" BorderThickness="0,0,0,1" Cursor="Hand"
                    MouseLeftButtonUp="Row_MouseLeftButtonUp">
                <Grid>
                    <!-- activity sweep (lit state) -->
                    <Border Background="{Binding RowBrush}" IsHitTestVisible="False"/>
                    <Border x:Name="Hover" Background="#12FFFFFF" Opacity="0" IsHitTestVisible="False"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="34"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- accent bar -->
                        <Border Grid.Column="0" Background="{Binding BarBrush}"/>

                        <!-- LED -->
                        <Grid Grid.Column="1" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse Fill="{Binding GlowBrush}" IsHitTestVisible="False"/>
                            <Ellipse Width="9" Height="9" Fill="{Binding LightBrush}"
                                     Stroke="#99000000" StrokeThickness="1"/>
                        </Grid>

                        <!-- name -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="2,0,8,0">
                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{Binding NameBrush}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding SubText}" FontSize="10" Foreground="#FF6A6A6A"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding SubVisibility}"/>
                        </StackPanel>

                        <!-- switch -->
                        <ToggleButton Grid.Column="3" Margin="0,0,12,0" VerticalAlignment="Center"
                                      Style="{StaticResource SwitchStyle}"
                                      IsChecked="{Binding Enable, Mode=TwoWay}"/>
                    </Grid>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Hover" Property="Opacity" Value="1"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ===== Group ===== -->
        <DataTemplate x:Key="GroupTemplate">
            <StackPanel>
                <!-- header -->
                <Border Height="38" Background="#FF262626" Cursor="Hand"
                        BorderBrush="#FF0C0C0C" BorderThickness="0,1,0,0"
                        MouseLeftButtonUp="Group_MouseLeftButtonUp">
                    <Grid Margin="10,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding ChevronText}" FontSize="11"
                                   Foreground="{Binding AccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13" FontWeight="Bold"
                                   Foreground="#FFF2F2F2" VerticalAlignment="Center"/>

                        <!-- count pill -->
                        <Border Grid.Column="2" Height="22" MinWidth="84" Padding="0"
                                VerticalAlignment="Center" HorizontalAlignment="Right"
                                CornerRadius="11" Background="#FF141414"
                                BorderBrush="#33FFFFFF" BorderThickness="1">
                            <TextBlock Text="{Binding CountText}" FontSize="11" Foreground="#FFEAEAEA"
                                       Margin="12,0" Padding="0"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- nodes -->
                <ItemsControl ItemsSource="{Binding Nodes}"
                              ItemTemplate="{StaticResource NodeTemplate}"
                              Visibility="{Binding BodyVisibility}"/>
            </StackPanel>
        </DataTemplate>

    </UserControl.Resources>

    <ScrollViewer x:Name="Scroller"
                  Background="Transparent"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False">
        <ItemsControl x:Name="GroupList" Background="Transparent" ItemTemplate="{StaticResource GroupTemplate}"/>
    </ScrollViewer>
</UserControl>
