<UserControl x:Class="NIM.YDControls.ContextView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:NIM.YDControls"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="1050"
             Background="#FF0C0C0C" Foreground="#FFEAEAEA">

    <UserControl.Resources>

        <!-- ===== Scrollbar (thin, dark) ===== -->
        <Style x:Key="NullRepeat" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThinThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="T" Margin="1" CornerRadius="3" Background="#55FFFFFF"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="T" Property="Background" Value="#99FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="T" Property="Background" Value="#CC4FC3F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="HScrollTemplate" TargetType="ScrollBar">
            <Grid Height="8" Background="#11FFFFFF">
                <Track x:Name="PART_Track">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource NullRepeat}"/>
                    </Track.DecreaseRepeatButton>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource NullRepeat}"/>
                    </Track.IncreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource ThinThumb}"/>
                    </Track.Thumb>
                </Track>
            </Grid>
        </ControlTemplate>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Width="8" Background="#11FFFFFF">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource NullRepeat}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource NullRepeat}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ThinThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="8"/>
                    <Setter Property="Template" Value="{StaticResource HScrollTemplate}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ===== TextBox ===== -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF1B1B1B"/>
            <Setter Property="Foreground" Value="#FFEAEAEA"/>
            <Setter Property="CaretBrush" Value="#FFFFFFFF"/>
            <Setter Property="SelectionBrush" Value="#664FC3F7"/>
            <Setter Property="BorderBrush" Value="#FF484848"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="B" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="#99FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="#FF4FC3F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== ComboBox ===== -->
        <ControlTemplate x:Key="ComboToggleTemplate" TargetType="ToggleButton">
            <Border x:Name="B" Background="#FF1B1B1B" BorderBrush="#FF484848"
                    BorderThickness="1" CornerRadius="3">
                <Path Data="M 0 0 L 4 4 L 8 0" Stroke="#FFBBBBBB" StrokeThickness="1.5"
                      HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="B" Property="BorderBrush" Value="#99FFFFFF"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="B" Property="BorderBrush" Value="#FF4FC3F7"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#FFEAEAEA"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="B" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#334FC3F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#FFEAEAEA"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="MaxDropDownHeight" Value="300"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="Root">
                            <ToggleButton Template="{StaticResource ComboToggleTemplate}" Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter Margin="10,0,26,0" IsHitTestVisible="False"
                                              VerticalAlignment="Center" HorizontalAlignment="Left"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, ElementName=Root}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Margin="0,2,0,0" Background="#FF1B1B1B"
                                        BorderBrush="#FF484848" BorderThickness="1" CornerRadius="3">
                                    <ScrollViewer CanContentScroll="False">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Slider ===== -->
        <Style x:Key="SliderThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse x:Name="E" Width="14" Height="14" Fill="#FFEAEAEA"
                                 Stroke="#FF484848" StrokeThickness="1"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="E" Property="Fill" Value="#FF4FC3F7"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="E" Property="Fill" Value="#FF4FC3F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Height" Value="20"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="#FF1B1B1B"
                                    BorderBrush="#FF484848" BorderThickness="1" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource NullRepeat}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource NullRepeat}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Button ===== -->
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#FFEAEAEA"/>
            <Setter Property="Background" Value="#FF1B1B1B"/>
            <Setter Property="BorderBrush" Value="#FF484848"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Height="30" MinWidth="76" CornerRadius="3"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="#FFFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Labels ===== -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF6A6A6A"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
        </Style>
        <Style x:Key="FieldValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFEAEAEA"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" Name="ControlCol"/>
            <ColumnDefinition Width="2"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Left: settings ===== -->
        <Grid Grid.Column="0" Background="#FF111111">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Height="38" Background="#FF262626" BorderBrush="#FF0C0C0C" BorderThickness="0,1,0,0">
                <TextBlock Text="N-GRAM CONTEXT MATCHING" FontSize="13" FontWeight="Bold"
                           Foreground="#FFF2F2F2" VerticalAlignment="Center" Margin="12,0"/>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False">
                <StackPanel Margin="12,0,12,14">
                    <TextBlock Text="DEMO CASE" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="CaseBox" SelectionChanged="CaseBox_SelectionChanged"/>

                    <TextBlock Text="LANGUAGE (AUTO = ENGINE DETECTION)" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="LangBox" SelectionChanged="LangBox_SelectionChanged"/>

                    <TextBlock Text="SOURCE TEXT (HEAD)" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="HeadBox" TextWrapping="Wrap" MinHeight="48" AcceptsReturn="False"/>

                    <TextBlock Text="CANDIDATES (ONE PER LINE)" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="CandBox" TextWrapping="Wrap" Height="150" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"/>

                    <Grid>
                        <TextBlock Text="SIMILARITY THRESHOLD" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Style="{StaticResource FieldValue}" HorizontalAlignment="Right"
                                   Text="{Binding Value, ElementName=ThresholdSlider, StringFormat={}{0:F2}}"/>
                    </Grid>
                    <Slider x:Name="ThresholdSlider" Minimum="0.05" Maximum="0.8" Value="0"
                            TickFrequency="0.05" IsSnapToTickEnabled="True" IsEnabled="False" />

                    <Grid>
                        <TextBlock Text="ANIMATION SPEED" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Style="{StaticResource FieldValue}" HorizontalAlignment="Right"
                                   Text="{Binding Value, ElementName=SpeedSlider, StringFormat={}{0:F2}x}"/>
                    </Grid>
                    <Slider x:Name="SpeedSlider" Minimum="0.25" Maximum="6" Value="1"/>

                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button Content="▶  Play" BorderBrush="#FF4FC3F7" Click="PlayBtn_Click"/>
                        <Button Content="■  Stop" Click="StopBtn_Click"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Column="1" Background="#FF1C1C1C"/>

        <!-- ===== Right: stage ===== -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Height="38" Background="#FF262626" BorderBrush="#FF0C0C0C" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" Margin="12,0">
                    <Ellipse Width="8" Height="8" Fill="#FF4FC3F7" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="StatusText" Text="Pick a case and press Play"
                               FontFamily="Consolas" FontSize="12" Foreground="#FFEAEAEA"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False" Background="Transparent">
                <StackPanel x:Name="Stage" Margin="0,0,0,16"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>