<UserControl x:Class="NIM.YDControls.NodeConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:NIM.YDControls"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="520"
             Background="Transparent">

    <UserControl.Resources>

        <local:InverseBoolConverter x:Key="InvBool"/>

        <Style x:Key="InputCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#FFEAEAEA"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="TextSearch.TextPath" Value="Content"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" Background="#FF0C0C0C" BorderBrush="#FF3A3A3A"
                                        BorderThickness="1" CornerRadius="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="#FFEAEAEA"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{Binding Text, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
                                                <Path Grid.Column="1" Data="M0,0 L4,4 L8,0" Stroke="#FF8A8A8A"
                                              StrokeThickness="1.2" Margin="8,0,10,0"
                                              VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF6A6A6A"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FFEAEAEA"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="4"
                           AllowsTransparency="True" StaysOpen="False" Focusable="False"
                           IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border Background="#FF161616" BorderBrush="#FF4A4A4A" BorderThickness="1"
                                CornerRadius="4" MaxHeight="240"
                                MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#FFE6E6E6"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Bd" Padding="10,6" Background="Transparent"
                                    BorderBrush="Transparent" BorderThickness="2,0,0,0">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#18FFFFFF"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#FFFFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Scrollbar (thin, dark) ===== -->
        <Style x:Key="NullRepeat" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThinThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="T" Margin="1,0" CornerRadius="3" Background="#55FFFFFF"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="T" Property="Background" Value="#99FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="T" Property="Background" Value="#CCFFE600"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Width="8" Background="#11FFFFFF">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource NullRepeat}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource NullRepeat}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ThinThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Text ===== -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FF8A8A8A"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ===== Input (focus colour comes from Tag = accent brush) ===== -->
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#FFEAEAEA"/>
            <Setter Property="CaretBrush" Value="#FFFFFFFF"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="#FF0C0C0C" BorderBrush="#FF3A3A3A"
                                BorderThickness="1" CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="8,0"
                                          VerticalAlignment="Center" Focusable="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF6A6A6A"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush"
                                        Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BareBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#FFEAEAEA"/>
            <Setter Property="CaretBrush" Value="#FFFFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Buttons ===== -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="60"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#FFEAEAEA"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#FF1E1E1E" BorderBrush="#FF4A4A4A"
                                BorderThickness="1" CornerRadius="4" Padding="12,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FFFFFFFF"/>
                                <Setter TargetName="Bd" Property="Background" Value="#FF2A2A2A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF3A3A3A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Height" Value="24"/>
            <Setter Property="MinWidth" Value="56"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#FFFFD6D6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#FF3A0E0E" BorderBrush="#FF8A2A2A"
                                BorderThickness="1" CornerRadius="4" Padding="10,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF5A1414"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FFFF5252"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF721A1A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionToggle" TargetType="ToggleButton">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="84"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#FFEAEAEA"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="#FF1E1E1E" BorderBrush="#FF4A4A4A"
                                BorderThickness="1" CornerRadius="4" Padding="12,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FFFFFFFF"/>
                                <Setter TargetName="Bd" Property="Background" Value="#FF2A2A2A"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FFFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Filter chip ===== -->
        <Style x:Key="Chip" TargetType="RadioButton">
            <Setter Property="Height" Value="24"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#FFB0B0B0"/>
            <Setter Property="Margin" Value="0,0,6,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="#FF1A1A1A" BorderBrush="#FF3A3A3A"
                                BorderThickness="1" CornerRadius="12" Padding="10,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF8A8A8A"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF2E2E2E"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FFEAEAEA"/>
                                <Setter Property="Foreground" Value="#FFFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Lists ===== -->
        <Style x:Key="DarkList" TargetType="ListBox">
            <Setter Property="Background" Value="#FF0C0C0C"/>
            <Setter Property="BorderBrush" Value="#FF2A2A2A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" SnapsToDevicePixels="True">
                            <ScrollViewer Focusable="False" Padding="0">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#FFE6E6E6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Padding="10,6" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="2,0,0,0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#18FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FFFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Node card ===== -->
        <DataTemplate x:Key="CardTemplate">
            <Border Background="#FF111111" BorderBrush="#FF2A2A2A" BorderThickness="1"
                    CornerRadius="6" Margin="0,0,8,10">
                <StackPanel>

                    <!-- header -->
                    <Border Height="46" Background="#FF262626" CornerRadius="{Binding HeaderCorner}"
                            BorderBrush="#FF0C0C0C" BorderThickness="0,0,0,1" Cursor="Hand"
                            MouseLeftButtonUp="Header_MouseLeftButtonUp">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{Binding AccentBrush}" CornerRadius="{Binding BarCorner}"/>

                            <Grid Grid.Column="1" Width="26" Height="26" Margin="8,0,0,0" VerticalAlignment="Center">
                                <Ellipse Fill="{Binding GlowBrush}" IsHitTestVisible="False"/>
                                <Ellipse Width="9" Height="9" Fill="{Binding LedBrush}"
                                         Stroke="#99000000" StrokeThickness="1"/>
                            </Grid>

                            <!-- DockPanel (not a horizontal StackPanel): the name takes the leftover
                                 width and trims, so the header shrinks with the control -->
                            <DockPanel Grid.Column="2" LastChildFill="True" VerticalAlignment="Center" Margin="4,0,8,0">
                                <TextBlock DockPanel.Dock="Left" Text="{Binding ChevronText}" FontSize="11"
                                           Foreground="{Binding AccentBrush}"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Border DockPanel.Dock="Right" Margin="10,0,0,0" Height="18" CornerRadius="9"
                                        Background="#FF141414" BorderBrush="#33FFFFFF" BorderThickness="1"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TypeLabel}" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{Binding AccentBrush}" Margin="9,0"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" FontSize="15" FontWeight="Bold"
                                           Foreground="#FFF2F2F2" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </DockPanel>

                            <TextBlock Grid.Column="3" Text="Document ↗" FontSize="11" Foreground="#FF9AD7FF"
                                       TextDecorations="Underline" Cursor="Hand" VerticalAlignment="Center"
                                       Margin="0,0,12,0" Visibility="{Binding DocVisibility}"
                                       MouseLeftButtonUp="DocLink_MouseLeftButtonUp"/>
                        </Grid>
                    </Border>

                    <!-- body -->
                    <StackPanel Margin="14,14,14,2" Visibility="{Binding BodyVisibility}">

                        <!-- API KEYS -->
                        <StackPanel Margin="0,0,0,16" Visibility="{Binding KeyVisibility}">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Border Width="3" Height="10" CornerRadius="1.5" Margin="0,0,6,0"
                                        Background="{Binding AccentBrush}"/>
                                <TextBlock Text="API KEYS" Style="{StaticResource SectionLabel}"/>
                            </StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="KeyBox" Grid.Column="0" Style="{StaticResource InputBox}"
                                         Tag="{Binding AccentBrush}" KeyDown="KeyBox_KeyDown"/>
                                <Button Grid.Column="2" Content="Add" Style="{StaticResource ActionButton}"
                                        Tag="{Binding ElementName=KeyBox}" Click="AddKey_Click"/>
                                <Button Grid.Column="4" Content="Remove" Style="{StaticResource ActionButton}"
                                        Tag="{Binding ElementName=KeyList}" Click="RemoveKey_Click"/>
                            </Grid>

                            <ListBox x:Name="KeyList" Height="96" Margin="0,8,0,0"
                                     ItemsSource="{Binding Keys}"
                                     Style="{StaticResource DarkList}"
                                     ItemContainerStyle="{StaticResource DarkItem}"
                                     PreviewMouseWheel="Inner_PreviewMouseWheel">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Masked}" FontFamily="Consolas" FontSize="12"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>

                        <!-- MODEL (cloud AI) -->
                        <StackPanel Margin="0,0,0,16" Visibility="{Binding ModelVisibility}">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Border Width="3" Height="10" CornerRadius="1.5" Margin="0,0,6,0"
                                        Background="{Binding AccentBrush}"/>
                                <TextBlock Text="MODEL" Style="{StaticResource SectionLabel}"/>
                            </StackPanel>

                            <Grid x:Name="ModelRow">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0" Style="{StaticResource InputBox}"
                                         Tag="{Binding AccentBrush}"
                                         Text="{Binding Model, Mode=TwoWay, UpdateSourceTrigger=Explicit}"
                                         KeyDown="CommitBox_KeyDown"
                                         LostKeyboardFocus="CommitBox_LostKeyboardFocus"/>

                                <ToggleButton Grid.Column="2" Content="Models ▾"
                                              Style="{StaticResource ActionToggle}"
                                              Visibility="{Binding ModelsToggleVisibility}"
                                              IsChecked="{Binding IsModelsOpen, Mode=TwoWay}"
                                              IsHitTestVisible="{Binding IsModelsOpen, Converter={StaticResource InvBool}}"/>

                                <Popup PlacementTarget="{Binding ElementName=ModelRow}" Placement="Bottom"
                                       VerticalOffset="4" StaysOpen="False" AllowsTransparency="True"
                                       PopupAnimation="Fade"
                                       IsOpen="{Binding IsModelsOpen, Mode=TwoWay}">
                                    <Border Background="#FF161616" BorderBrush="#FF4A4A4A" BorderThickness="1"
                                            CornerRadius="4" MaxHeight="240"
                                            MinWidth="{Binding ActualWidth, ElementName=ModelRow}">
                                        <ListBox Style="{StaticResource DarkList}" Background="Transparent"
                                                 BorderThickness="0"
                                                 ItemsSource="{Binding Models}"
                                                 ItemContainerStyle="{StaticResource DarkItem}"
                                                 SelectionChanged="ModelsList_SelectionChanged"/>
                                    </Border>
                                </Popup>
                            </Grid>
                        </StackPanel>

                        <!-- LOCAL SERVER -->
                        <StackPanel Margin="0,0,0,16" Visibility="{Binding PortVisibility}">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Border Width="3" Height="10" CornerRadius="1.5" Margin="0,0,6,0"
                                        Background="{Binding AccentBrush}"/>
                                <TextBlock Text="PORT" Style="{StaticResource SectionLabel}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBox Width="120" MaxLength="5" Style="{StaticResource InputBox}" Tag="{Binding AccentBrush}" Text="{Binding PortText, Mode=TwoWay, UpdateSourceTrigger=Explicit}" PreviewTextInput="PortBox_PreviewTextInput"  KeyDown="CommitBox_KeyDown" LostKeyboardFocus="CommitBox_LostKeyboardFocus"/>
                                <ComboBox Style="{StaticResource InputCombo}" Width="120" Height="28" Margin="8,0,0,0" ItemsSource="{Binding Backends}" SelectedItem="{Binding SelectedBackend, Mode=TwoWay}" DisplayMemberPath="Name" TextSearch.TextPath="Name" Visibility="{Binding BackendVisibility}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,16,0,6">
                                <Border Width="3" Height="10" CornerRadius="1.5" Margin="0,0,6,0"
                                        Background="{Binding AccentBrush}"/>
                                <TextBlock Text="CURRENT MODEL" Style="{StaticResource SectionLabel}"/>
                            </StackPanel>
                            <Border Height="28" Background="#FF0C0C0C" BorderBrush="#FF2A2A2A"
                                    BorderThickness="1" CornerRadius="4">
                                <TextBlock Text="{Binding ModelDisplay}" Margin="8,0" FontSize="12"
                                           Foreground="{Binding AccentBrush}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </Border>
                        </StackPanel>

                        <!-- nothing to configure -->
                        <TextBlock Text="This node needs no configuration." FontSize="12" Foreground="#FF6A6A6A"
                                   Margin="0,0,0,16" Visibility="{Binding EmptyVisibility}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== toolbar: search + filter ===== -->
        <Border Grid.Row="0" Background="#FF111111" BorderBrush="#FF2A2A2A" BorderThickness="1"
                CornerRadius="6" Padding="10" Margin="0,0,8,10">
            <StackPanel>

                <!-- search -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Height="30" Background="#FF0C0C0C" CornerRadius="4" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="#FF3A3A3A"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=SearchBox}" Value="True">
                                        <Setter Property="BorderBrush" Value="#FFEAEAEA"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Width="16" Height="16" Margin="10,0,6,0" IsHitTestVisible="False">
                                <Ellipse Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top"
                                         Stroke="#FF8A8A8A" StrokeThickness="1.5"/>
                                <Line X1="9" Y1="9" X2="15" Y2="15" Stroke="#FF8A8A8A" StrokeThickness="1.5"/>
                            </Grid>

                            <Grid Grid.Column="1">
                                <TextBlock x:Name="PlaceholderText" Text="Search nodes…" FontSize="12"
                                           Foreground="#FF5A5A5A" VerticalAlignment="Center" IsHitTestVisible="False"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBox x:Name="SearchBox" Style="{StaticResource BareBox}"
                                         TextChanged="SearchBox_TextChanged"/>
                            </Grid>

                            <TextBlock x:Name="ClearBtn" Grid.Column="2" Text="✕" FontSize="11" Foreground="#FF8A8A8A"
                                       Margin="8,0,10,0" VerticalAlignment="Center" Cursor="Hand"
                                       Visibility="Collapsed" MouseLeftButtonUp="ClearSearch_MouseLeftButtonUp"/>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="CountText" Grid.Column="1" FontSize="11" Foreground="#FF8A8A8A"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                </Grid>

                <!-- chips + expand/collapse -->
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                        <RadioButton x:Name="AllChip" GroupName="NodeTypeFilter" Tag="all" IsChecked="True"
                                     Style="{StaticResource Chip}" Checked="Chip_Checked">
                            <TextBlock Text="All"/>
                        </RadioButton>
                        <RadioButton GroupName="NodeTypeFilter" Tag="cloud" Style="{StaticResource Chip}" Checked="Chip_Checked">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="#FF4FC3F7" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Cloud AI"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="NodeTypeFilter" Tag="local" Style="{StaticResource Chip}" Checked="Chip_Checked">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="#FFFFE600" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Local AI"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="NodeTypeFilter" Tag="trad" Style="{StaticResource Chip}" Checked="Chip_Checked">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="#FFE0E0E0" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Traditional"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="NodeTypeFilter" Tag="human" Style="{StaticResource Chip}" Checked="Chip_Checked">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="#FFFF9100" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Interactive"/>
                            </StackPanel>
                        </RadioButton>
                    </WrapPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,0,0,0">
                        <Button Content="Expand" Height="24" MinWidth="56" Style="{StaticResource ActionButton}"
                                Click="ExpandAll_Click"/>
                        <Button Content="Collapse" Height="24" MinWidth="56" Margin="6,0,0,0"
                                Style="{StaticResource ActionButton}" Click="CollapseAll_Click"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ===== cards ===== -->
        <Grid Grid.Row="1">
            <ScrollViewer x:Name="MainScroller" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                <ItemsControl x:Name="CardList" ItemTemplate="{StaticResource CardTemplate}"
                              HorizontalContentAlignment="Stretch"/>
            </ScrollViewer>

            <TextBlock x:Name="NoResult" Text="No nodes match" FontSize="12" Foreground="#FF6A6A6A"
                       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0"
                       Visibility="Collapsed" IsHitTestVisible="False"/>
        </Grid>
    </Grid>
</UserControl>
