<UserControl x:Class="NIM.YDControls.PluginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:NIM.YDControls"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="520"
             Background="Transparent"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>

        <!-- ===== Scrollbar ===== -->
        <Style x:Key="NullRepeat" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThinThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="T" Margin="1,0" CornerRadius="3" Background="#55FFFFFF"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="T" Property="Background" Value="#99FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="T" Property="Background" Value="#CC4FC3F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Width="8" Background="#11FFFFFF">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource NullRepeat}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource NullRepeat}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ThinThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Text ===== -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FF8A8A8A"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="BareBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#FFEAEAEA"/>
            <Setter Property="CaretBrush" Value="#FFFFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Buttons ===== -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="24"/>
            <Setter Property="MinWidth" Value="56"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#FFEAEAEA"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#FF1E1E1E" BorderBrush="#FF4A4A4A"
                                BorderThickness="1" CornerRadius="4" Padding="12,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FFFFFFFF"/>
                                <Setter TargetName="Bd" Property="Background" Value="#FF2A2A2A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF3A3A3A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Switch ===== -->
        <Style x:Key="SwitchToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" CornerRadius="11" Background="#FF1A1A1A"
                                BorderBrush="#FF4A4A4A" BorderThickness="1">
                            <Ellipse x:Name="Knob" Width="14" Height="14" Fill="#FF8A8A8A"
                                     HorizontalAlignment="Left" Margin="3,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="#FFEAEAEA"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#3300E5FF"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="#FF4FC3F7"/>
                                <Setter TargetName="Knob" Property="Fill" Value="#FF4FC3F7"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Filter chip ===== -->
        <Style x:Key="Chip" TargetType="RadioButton">
            <Setter Property="Height" Value="24"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#FFB0B0B0"/>
            <Setter Property="Margin" Value="0,0,6,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="#FF1A1A1A" BorderBrush="#FF3A3A3A"
                                BorderThickness="1" CornerRadius="12" Padding="10,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF8A8A8A"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF2E2E2E"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FFEAEAEA"/>
                                <Setter Property="Foreground" Value="#FFFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Plugin card ===== -->
        <DataTemplate x:Key="CardTemplate">
            <Border x:Name="Card" Background="#FF111111" BorderBrush="#FF2A2A2A" BorderThickness="1"
                    CornerRadius="6" Margin="0,0,8,10">
                <StackPanel>

                    <!-- header -->
                    <Border x:Name="Header" Height="48" Background="#FF262626" CornerRadius="5,5,0,0"
                            BorderBrush="#FF0C0C0C" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="Bar" Grid.Column="0" Background="#FF4A4A4A" CornerRadius="5,0,0,0"/>

                            <Grid Grid.Column="1" Width="26" Height="26" Margin="10,0,0,0" VerticalAlignment="Center">
                                <Ellipse x:Name="Glow" Fill="#00000000" IsHitTestVisible="False"/>
                                <Ellipse x:Name="Led" Width="9" Height="9" Fill="#FF5A5A5A"
                                         Stroke="#99000000" StrokeThickness="1"/>
                            </Grid>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,8,0">
                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" Foreground="#FFF2F2F2"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="240"/>
                                <Border Margin="10,0,0,0" Height="18" CornerRadius="9" Background="#FF141414"
                                        BorderBrush="#33FFFFFF" BorderThickness="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding VersionText}" FontSize="10" FontWeight="SemiBold"
                                               Foreground="#FF9AD7FF" Margin="9,0"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock x:Name="StateText" Text="DISABLED" FontSize="10" FontWeight="Bold"
                                           Foreground="#FF6A6A6A" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ToggleButton Style="{StaticResource SwitchToggle}"
                                              IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                              Click="Toggle_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- body -->
                    <StackPanel Margin="14,12,14,12">

                        <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#FFCFCFCF"
                                   TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="AUTHOR" Style="{StaticResource SectionLabel}"/>
                            <TextBlock Grid.Column="1" Text="{Binding AuthorText}" FontSize="12" Foreground="#FFEAEAEA"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="FILE" Style="{StaticResource SectionLabel}"/>
                            <TextBlock Grid.Column="1" Text="{Binding FileName}" ToolTip="{Binding FilePath}" FontSize="11" TextTrimming="CharacterEllipsis" MouseLeftButtonUp="File_MouseLeftButtonUp" Foreground="#FF4FC3F7" Cursor="Hand"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="SHA256" Style="{StaticResource SectionLabel}"/>
                            <TextBlock Grid.Column="1" Text="{Binding ShortHash}" FontSize="11" Foreground="#FF9A9A9A" HorizontalAlignment="Left"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                    <Setter TargetName="Bar" Property="Background" Value="#FF4FC3F7"/>
                    <Setter TargetName="Led" Property="Fill" Value="#FF4FC3F7"/>
                    <Setter TargetName="Glow" Property="Fill" Value="#334FC3F7"/>
                    <Setter TargetName="Card" Property="BorderBrush" Value="#444FC3F7"/>
                    <Setter TargetName="StateText" Property="Text" Value="ENABLED"/>
                    <Setter TargetName="StateText" Property="Foreground" Value="#FF4FC3F7"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== toolbar ===== -->
        <Border Grid.Row="0" Background="#FF111111" BorderBrush="#FF2A2A2A" BorderThickness="1"
                CornerRadius="6" Padding="10" Margin="0,0,8,10">
            <StackPanel>

                <!-- search -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Height="30" Background="#FF0C0C0C" CornerRadius="4" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="#FF3A3A3A"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=SearchBox}" Value="True">
                                        <Setter Property="BorderBrush" Value="#FF4FC3F7"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Width="16" Height="16" Margin="10,0,6,0" IsHitTestVisible="False">
                                <Ellipse Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top"
                                         Stroke="#FF8A8A8A" StrokeThickness="1.5"/>
                                <Line X1="9" Y1="9" X2="15" Y2="15" Stroke="#FF8A8A8A" StrokeThickness="1.5"/>
                            </Grid>

                            <Grid Grid.Column="1">
                                <TextBlock x:Name="PlaceholderText" Text="Search plugins (name / author / description / hash)…"
                                           FontSize="12" Foreground="#FF5A5A5A" VerticalAlignment="Center"
                                           IsHitTestVisible="False"/>
                                <TextBox x:Name="SearchBox" Style="{StaticResource BareBox}"
                                         TextChanged="SearchBox_TextChanged"/>
                            </Grid>

                            <TextBlock x:Name="ClearBtn" Grid.Column="2" Text="✕" FontSize="11" Foreground="#FF8A8A8A"
                                       Margin="8,0,10,0" VerticalAlignment="Center" Cursor="Hand"
                                       Visibility="Collapsed" MouseLeftButtonUp="ClearSearch_MouseLeftButtonUp"/>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="CountText" Grid.Column="1" FontSize="11" Foreground="#FF8A8A8A"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                </Grid>

                <!-- chips + actions -->
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                        <RadioButton x:Name="AllChip" GroupName="PluginFilter" Tag="all" IsChecked="True"
                                     Style="{StaticResource Chip}" Checked="Chip_Checked">
                            <TextBlock Text="All"/>
                        </RadioButton>
                        <RadioButton GroupName="PluginFilter" Tag="on" Style="{StaticResource Chip}" Checked="Chip_Checked">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="#FF4FC3F7" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Enabled"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="PluginFilter" Tag="off" Style="{StaticResource Chip}" Checked="Chip_Checked">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="#FF5A5A5A" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Disabled"/>
                            </StackPanel>
                        </RadioButton>
                    </WrapPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,0,0,0">
                        <Button Content="Disable all" Margin="6,0,0,0" Style="{StaticResource ActionButton}" Click="DisableAll_Click"/>
                        <Button Content="Refresh" Margin="6,0,0,0" Style="{StaticResource ActionButton}" Click="Refresh_Click"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ===== cards ===== -->
        <Grid Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False">
                <ItemsControl x:Name="CardList" ItemTemplate="{StaticResource CardTemplate}"/>
            </ScrollViewer>

            <TextBlock x:Name="NoResult" Text="No plugins found" FontSize="12" Foreground="#FF6A6A6A"
                       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0"
                       Visibility="Collapsed" IsHitTestVisible="False"/>
        </Grid>
    </Grid>
</UserControl>
